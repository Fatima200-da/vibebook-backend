generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================
// USERS
// =======================

model users {
  id String @id @default(uuid())

  full_name String

  email String @unique

  phone String?

  password String

  role String @default("USER")

  albums albums[]

  orders orders[]

  addresses addresses[]

  wishlist_items wishlist_items[]

  reviews reviews[]

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt
}

model addresses {
  id String @id @default(uuid())

  user_id String

  label String?
  full_name String
  phone String
  address_line String

  is_default Boolean @default(false)

  users users @relation(fields: [user_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// =======================
// ADMIN USERS
// =======================

model admin_users {
  id String @id @default(uuid())

  full_name String

  email String @unique

  password String

  role String @default("ADMIN")

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt
}

// =======================
// CATEGORIES
// =======================

model categories {
  id String @id @default(uuid())

  name String @unique

  image String?

  products products[]

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt
}

// =======================
// PRODUCTS
// =======================

model products {
  id String @id @default(uuid())

  category_id String

  title String

  description String?

  price Decimal

  cover_type String?

  min_pages Int

  max_pages Int

  image String?

  is_deleted Boolean @default(false)

  categories categories @relation(fields: [category_id], references: [id])

  albums albums[]

  order_items order_items[]

  wishlist_items wishlist_items[]

  reviews reviews[]

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt
}

model reviews {
  id String @id @default(uuid())

  user_id String
  product_id String

  rating Int
  title String?
  comment String

  users users @relation(fields: [user_id], references: [id])
  products products @relation(fields: [product_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, product_id])
}

model wishlist_items {
  id String @id @default(uuid())

  user_id String
  product_id String

  users users @relation(fields: [user_id], references: [id])
  products products @relation(fields: [product_id], references: [id])

  created_at DateTime @default(now())

  @@unique([user_id, product_id])
}

// =======================
// COVERS
// =======================

model covers {
  id String @id @default(uuid())

  name String

  image String?

  type String?

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt
}

// =======================
// TEMPLATES
// =======================

model templates {
  id String @id @default(uuid())

  name String @unique

  description String?

  preview_image String?

  pages Json?

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt

  albums albums[]
}

// =======================
// ALBUMS
// =======================

model albums {
  id String @id @default(uuid())

  user_id String?

  product_id String?

  template_id String?

  title String

  total_pages Int

  status String @default("DRAFT")

  users users? @relation(fields: [user_id], references: [id])

  products products? @relation(fields: [product_id], references: [id])

  templates templates? @relation(fields: [template_id], references: [id])

  pages album_pages[]

  order_items order_items[]

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt
}

// =======================
// ALBUM PAGES
// =======================

model album_pages {
  id String @id @default(uuid())

  album_id String

  page_number Int

  background String?

  album albums @relation(fields: [album_id], references: [id])

  photos photos[]

  texts text_layers[]

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt
}

// =======================
// PHOTOS
// =======================

model photos {
  id String @id @default(uuid())

  page_id String

  url String

  position Json?

  page album_pages @relation(fields: [page_id], references: [id])

  created_at DateTime @default(now())
}

// =======================
// TEXT LAYERS
// =======================

model text_layers {
  id String @id @default(uuid())

  page_id String

  text String

  style Json?

  page album_pages @relation(fields: [page_id], references: [id])

  created_at DateTime @default(now())
}

// =======================
// ORDERS
// =======================

model orders {
  id String @id @default(uuid())

  user_id String?

  album_id String?

  status String @default("PENDING")

  total_price Decimal

  shipping_name String?
  shipping_phone String?
  shipping_address String?

  users users? @relation(fields: [user_id], references: [id])

  payments payments[]

  order_items order_items[]

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt
}

// =======================
// PAYMENTS
// =======================

model payments {
  id String @id @default(uuid())

  order_id String

  amount Decimal

  status String

  orders orders @relation(fields: [order_id], references: [id])

  created_at DateTime @default(now())
}

// =======================
// ORDER ITEMS
// =======================

model order_items {
  id String @id @default(uuid())

  order_id String

  product_id String?

  album_id String?

  title String

  price Decimal

  quantity Int @default(1)

  orders orders @relation(fields: [order_id], references: [id])

  products products? @relation(fields: [product_id], references: [id])

  albums albums? @relation(fields: [album_id], references: [id])

  created_at DateTime @default(now())
}

// =======================
// SETTINGS
// =======================

model settings {
  id String @id @default(uuid())

  company_name String?
  phone String?
  email String?
  address String?

  instagram String?
  facebook String?

  logo String?
  favicon String?

  primary_color String?
  secondary_color String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model contact_messages {
  id String @id @default(uuid())

  name String
  email String
  subject String
  message String

  created_at DateTime @default(now())
}

// =======================
// AUDIT LOGS
// =======================

model audit_logs {
  id String @id @default(uuid())

  admin_id String?

  action String

  entity String

  entity_id String?

  details Json?

  created_at DateTime @default(now())
}