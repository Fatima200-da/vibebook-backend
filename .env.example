PORT=5000

# Comma-separated list of allowed frontend origins for CORS. In production
# this MUST be the real deployed frontend domain(s) only - never "*".
CORS_ORIGIN=http://localhost:5182

DATABASE_URL="postgresql://user:password@localhost:5432/vibebook_db"
JWT_SECRET=change_me

# Payment provider (Epoint). All required for /api/payments/create and the
# webhook to be active - if any are missing the payment endpoints return 503
# rather than simulating success. Get public_key/private_key by registering
# as a merchant at https://epoint.az. PAYMENT_API_URL is the base URL shown
# in the official docs after authenticating at https://developer.epoint.az.
PAYMENT_PROVIDER=epoint
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY=
PAYMENT_API_URL=
PAYMENT_RESULT_URL=http://localhost:5000/api/payments/webhook/epoint
PAYMENT_SUCCESS_URL=http://localhost:5182/payment/return
PAYMENT_ERROR_URL=http://localhost:5182/payment/return

# Storage backend (Phase 24B). "local" (default) needs nothing below - files
# stay on this server's disk under uploads/, unchanged from before this
# config existed. "s3" targets any S3-compatible provider (AWS S3, MinIO,
# DigitalOcean Spaces, Cloudflare R2) and requires every STORAGE_S3_* value.
STORAGE_PROVIDER=local
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PUBLIC_URL_BASE=
STORAGE_S3_FORCE_PATH_STYLE=false
